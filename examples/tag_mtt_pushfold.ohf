    WHEN f$Gen_EffStackFirstIn >= 3 AND f$Gen_EffStackFirstIn <= 4 AND InSmallBlind AND listPushSB3 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 3 AND f$Gen_EffStackFirstIn <= 4 AND InSmallBlind AND listPushSB3Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 4 AND f$Gen_EffStackFirstIn <= 5 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listPushEP5 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 4 AND f$Gen_EffStackFirstIn <= 5 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listPushEP5Edge AND randomhand < 0.50 RaiseMax FORCE
