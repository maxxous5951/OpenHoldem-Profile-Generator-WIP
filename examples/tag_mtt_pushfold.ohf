    WHEN NOT f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.299 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.120 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.156 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway Fold FORCE
    WHEN f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.561 Call FORCE
