// === PUSH/FOLD : face a des limpers ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1 AND f$Gen_EffStackFirstIn <= 15
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listPushLimpEP3 RaiseMax FORCE
