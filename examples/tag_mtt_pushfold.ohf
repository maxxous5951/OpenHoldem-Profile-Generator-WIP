    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.07 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.323 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.420 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.348 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.453 AND randomround < 0.50 Call FORCE
