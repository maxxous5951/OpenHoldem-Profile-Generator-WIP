    WHEN f$Gen_WeakSD AND f$Gen_PotOdds <= 0.224 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.090 Call FORCE
    WHEN f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.117 AND randomround < 0.50 Call FORCE
    WHEN Others Fold FORCE
// --- On fait face a une mise (c-bet adverse, donk, probe...) ---
WHEN AmountToCall > 0
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster Call FORCE
