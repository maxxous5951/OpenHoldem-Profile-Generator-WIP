// === OUVERTURE (personne n'est entre dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    WHEN (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listOpenEP RaiseTo 2.5 FORCE
    WHEN (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listOpenEPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN (InMiddlePosition2 OR InMiddlePosition3) AND listOpenMP RaiseTo 2.5 FORCE
    WHEN (InMiddlePosition2 OR InMiddlePosition3) AND listOpenMPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InCutOff AND listOpenCO RaiseTo 2.3 FORCE
    WHEN InCutOff AND listOpenCOEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenSB RaiseTo 3 FORCE
    WHEN InSmallBlind AND listOpenSBEdge AND randomhand < 0.50 RaiseTo 3 FORCE
    WHEN Others Fold FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listIso1EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND (InMiddlePosition2 OR InMiddlePosition3) AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND (InMiddlePosition2 OR InMiddlePosition3) AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
