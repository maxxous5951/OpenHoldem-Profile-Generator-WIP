##f$Gen_EffStack##
// Stack effectif en BB (petit stack entre nous et le plus gros adversaire encore en jeu)
WHEN Others RETURN EffectiveMaxStacksizeOfActiveOpponents FORCE

##f$Gen_EffStackFirstIn##
// Stack effectif contre les joueurs derriere nous (premiere action preflop)
WHEN Others RETURN (MaxStillToActStackSize < StackSize ? MaxStillToActStackSize : StackSize) FORCE

##f$Gen_IP##
// Vrai si nous agirons en dernier postflop
WHEN StillToActPostflop = 0 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Multiway##
WHEN Opponents >= 2 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$preflop##
// OHPG : fonction preflop. Chaque bloc WHEN sans action est un scenario ; il se termine par un fold/check.
// === PUSH/FOLD : premiere action, stack effectif <= 15 BB ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0 AND f$Gen_EffStackFirstIn <= 15
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listPushEP3 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listPushEP3Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND (InMiddlePosition2 OR InMiddlePosition3) AND listPushMP3 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND (InMiddlePosition2 OR InMiddlePosition3) AND listPushMP3Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND InCutOff AND listPushCO3 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND InCutOff AND listPushCO3Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND InButton AND listPushBTN3 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND InButton AND listPushBTN3Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND InSmallBlind AND listPushSB3 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 3 AND InSmallBlind AND listPushSB3Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 3 AND f$Gen_EffStackFirstIn <= 4 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listPushEP4 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 3 AND f$Gen_EffStackFirstIn <= 4 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listPushEP4Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 3 AND f$Gen_EffStackFirstIn <= 4 AND (InMiddlePosition2 OR InMiddlePosition3) AND listPushMP4 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 3 AND f$Gen_EffStackFirstIn <= 4 AND (InMiddlePosition2 OR InMiddlePosition3) AND listPushMP4Edge AND randomhand < 0.50 RaiseMax FORCE
    WHEN f$Gen_EffStackFirstIn >= 3 AND f$Gen_EffStackFirstIn <= 4 AND InCutOff AND listPushCO4 RaiseMax FORCE
