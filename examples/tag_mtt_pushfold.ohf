// === OUVERTURE (personne n'est entre dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    // Zone open-jam : stack effectif <= 22 BB, mains premium all-in (au-dessus, ouverture normale)
    WHEN (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 11 AND listOpenJamEP11 RaiseMax FORCE
    WHEN (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND f$Gen_EffStackFirstIn >= 11 AND f$Gen_EffStackFirstIn <= 22 AND listOpenJamEP22 RaiseMax FORCE
    WHEN (InMiddlePosition2 OR InMiddlePosition3) AND f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 11 AND listOpenJamMP11 RaiseMax FORCE
    WHEN (InMiddlePosition2 OR InMiddlePosition3) AND f$Gen_EffStackFirstIn >= 11 AND f$Gen_EffStackFirstIn <= 22 AND listOpenJamMP22 RaiseMax FORCE
    WHEN InCutOff AND f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 11 AND listOpenJamCO11 RaiseMax FORCE
    WHEN InCutOff AND f$Gen_EffStackFirstIn >= 11 AND f$Gen_EffStackFirstIn <= 22 AND listOpenJamCO22 RaiseMax FORCE
    WHEN InButton AND f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 11 AND listOpenJamBTN11 RaiseMax FORCE
