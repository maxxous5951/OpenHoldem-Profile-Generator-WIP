    WHEN Calls >= 3 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listIso3EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND listIso3EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
