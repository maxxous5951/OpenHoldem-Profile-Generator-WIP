// === FACE A UNE OUVERTURE (aucun caller) : 3bet value + bluffs, call, fold ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise = 0
    WHEN (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND (EarlyPosition2Raising OR EarlyPosition3Raising OR MiddlePosition1Raising) AND f$Gen_EffStack <= 24 AND listVEPEPSV RaiseMax FORCE
    WHEN (InEarlyPosition2 OR InEarlyPosition3 OR InMiddlePosition1) AND (EarlyPosition2Raising OR EarlyPosition3Raising OR MiddlePosition1Raising) AND listVEPEPV RaiseTo (f$Gen_Facing * 4) FORCE
