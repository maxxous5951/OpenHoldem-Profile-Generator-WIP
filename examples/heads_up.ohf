    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Air AND randomround < 0.65 RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 Check FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Monster RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Strong RaiseBy 33% FORCE
