    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_WeakSD AND randomround < 0.17 RaiseBy 43% FORCE
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_Air AND randomround < 0.25 RaiseBy 43% FORCE
    WHEN f$Gen_IP AND NOT f$Gen_Multiway Check FORCE
    WHEN Others Check FORCE
// --- On nous relance après notre mise / check-raise subi ---
WHEN AmountToCall > 0 AND RaisesSinceLastPlay >= 1 AND BotsActionsOnThisRoundIncludingChecks >= 1
    WHEN HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN f$Gen_Monster Call FORCE
    WHEN f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN f$Gen_Strong AND f$Gen_PotOdds <= 0.528 Call FORCE
    WHEN f$Gen_Strong AND f$Gen_PotOdds <= 0.686 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_NutDraw AND randomround < 0.15 RaiseBy 100% FORCE
    WHEN f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.376 Call FORCE
    WHEN f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.489 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Medium AND f$Gen_PotOdds <= 0.360 Call FORCE
    WHEN f$Gen_Medium AND f$Gen_PotOdds <= 0.468 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_WeakSD AND f$Gen_PotOdds <= 0.224 Call FORCE
    WHEN f$Gen_WeakSD AND f$Gen_PotOdds <= 0.291 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_WeakDraw AND f$Gen_IP AND f$Gen_PotOdds <= 0.28 AND randomround < 0.30 Call FORCE
    WHEN f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.160 Call FORCE
    WHEN f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.208 AND randomround < 0.50 Call FORCE
    WHEN Others Fold FORCE
// --- On fait face à une mise (c-bet adverse, donk, etc.) ---
WHEN AmountToCall > 0
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.660 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.858 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_NutDraw AND randomround < 0.15 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.470 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.611 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.450 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.585 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.280 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.364 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_IP AND f$Gen_PotOdds <= 0.28 AND randomround < 0.30 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.200 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.260 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway Fold FORCE
    WHEN f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.561 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.729 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_NutDraw AND randomround < 0.15 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.399 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.519 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.383 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.497 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.238 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.309 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_IP AND f$Gen_PotOdds <= 0.28 AND randomround < 0.30 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.170 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.221 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway Fold FORCE

##f$turn##
// OHPG : turn. Blocs : 2e barrel, c-bet retardé / probe, mise, relance subie, mise subie.
// --- 2e BARREL : nous avons misé au flop ---
WHEN AmountToCall = 0 AND BotRaisedOnFlop
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Scare AND f$Gen_Monster AND randomround < 0.90 RaiseBy 66% FORCE
