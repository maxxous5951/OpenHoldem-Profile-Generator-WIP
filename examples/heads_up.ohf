##f$Gen_EffStack##
// Stack effectif en BB (petit stack entre nous et le plus gros adversaire encore en jeu)
WHEN Others RETURN EffectiveMaxStacksizeOfActiveOpponents FORCE

##f$Gen_IP##
// Vrai si nous agirons en dernier postflop
WHEN StillToActPostflop = 0 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Facing##
// Taille totale (en BB) de la mise adverse : ce qu'il reste a payer + ce que nous avons deja mis (blinde, ouverture). BetSize (= ncallbets) ne donne que le complement, d'ou RaiseTo faux pour les blindes et apres notre relance
WHEN Others RETURN AmountToCall + ncurrentbets FORCE

##f$Gen_Multiway##
WHEN Opponents >= 2 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$preflop##
// OHPG : fonction preflop. Chaque bloc WHEN sans action est un scenario ; il se termine par un fold/check.
// === OUVERTURE (personne n'est entre dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    WHEN InButton AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN Others Fold FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1BB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1BBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso2BB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso2BBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso2BB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso2BBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3BB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3BBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN InBigBlind Check FORCE
    WHEN Others Fold FORCE
// === FACE A UNE OUVERTURE (aucun caller) : 3bet value + bluffs, call, fold ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise = 0
    WHEN InSmallBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVSBBTNSV RaiseMax FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNC Call FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVBBBTNSV RaiseMax FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVSBBTNB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNC Call FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND f$Gen_EffStack <= 20 AND listVBBSBSV RaiseMax FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBC Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === SQUEEZE : une ouverture et un ou plusieurs callers ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise >= 1
    WHEN CallsSinceLastRaise = 1 AND InButton AND f$Gen_EffStack <= 20 AND listSq1BTNSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1BTNSV RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1BTNB RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1BTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1BTNC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1BTNCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND f$Gen_EffStack <= 20 AND listSq1BTNSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1BTNSV RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1BTNB RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1BTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1SBC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1SBCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND f$Gen_EffStack <= 20 AND listSq1BTNSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BTNSV RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BTNB RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BBC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BBCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND f$Gen_EffStack <= 20 AND listSq2BTNSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2BTNSV RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2BTNB RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2BTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2BTNC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2BTNCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND f$Gen_EffStack <= 20 AND listSq2BTNSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2BTNSV RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2BTNB RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2BTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2SBC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2SBCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND f$Gen_EffStack <= 20 AND listSq2BTNSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2BTNSV RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2BTNB RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2BTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2BBC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2BBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS OUVERT ET FACE A UN 3BET : 4bet value/bluff, call, fold ===
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND Raises = 1 AND RaisesSinceLastPlay = 1 AND Calls = 0
    WHEN InButton AND f$Gen_EffStack <= 30 AND listF3BTNSV RaiseMax FORCE
    WHEN InButton AND listF3BTNV RaiseTo (f$Gen_Facing * 2.2) FORCE
    WHEN InButton AND listSq2BTNB RaiseTo (f$Gen_Facing * 2.2) FORCE
    WHEN InButton AND listF3BTNC Call FORCE
    WHEN InButton AND listF3BTNCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND f$Gen_EffStack <= 30 AND listF3BTNSV RaiseMax FORCE
    WHEN InSmallBlind AND listF3BTNV RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InSmallBlind AND listSq2BTNB RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InSmallBlind AND listF3SBC Call FORCE
    WHEN InSmallBlind AND listF3SBCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND f$Gen_EffStack <= 30 AND listF3BTNSV RaiseMax FORCE
    WHEN InBigBlind AND listF3BTNV RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InBigBlind AND listSq2BTNB RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InBigBlind AND listF3BBC Call FORCE
    WHEN InBigBlind AND listF3BBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND Raises = 1 AND RaisesSinceLastPlay = 1 AND Calls >= 1
    WHEN InButton AND f$Gen_EffStack <= 30 AND listF3SqBTNSV RaiseMax FORCE
    WHEN InButton AND listF3SqBTNV RaiseTo (f$Gen_Facing * 2.2) FORCE
    WHEN InButton AND listF3SqBTNB RaiseTo (f$Gen_Facing * 2.2) FORCE
    WHEN InButton AND listF3SqBTNC Call FORCE
    WHEN InButton AND listF3SqBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND f$Gen_EffStack <= 30 AND listF3SqBTNSV RaiseMax FORCE
    WHEN InSmallBlind AND listF3SqBTNV RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InSmallBlind AND listF3SqBTNB RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InSmallBlind AND listF3SqSBC Call FORCE
    WHEN InSmallBlind AND listF3SqSBCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND f$Gen_EffStack <= 30 AND listF3SqBTNSV RaiseMax FORCE
    WHEN InBigBlind AND listF3SqBTNV RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InBigBlind AND listF3SqBTNB RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN InBigBlind AND listF3SqBBC Call FORCE
    WHEN InBigBlind AND listF3SqBBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === OUVERTURE + 3BET DEVANT NOUS (cold) : 4bet tres serre ou call ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 2
    WHEN listColdF3V RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN listColdF3C Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS 3BETE ET FACE A UN 4BET : jam value/bluff, call, fold ===
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND Raises = 2 AND RaisesSinceLastPlay = 1
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listSq2BTNSV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF3SqBTNB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF4S8C Call FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF4S8Cp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3BTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3SqBTNB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF4S12C Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listIso3BBEdge AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF3BTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF3SqBTNB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF4S18C Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF4S18Cp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listF4S25V RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listF3SqBTNB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listF4S25C Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listF3BBCp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listF3SqBTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listF4S40B RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listF4S40C Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listF4S40Cp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listF3SqBTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listF4S40B RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listF3SqBBC Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listF4S10000Cp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === 4BET DEVANT NOUS (cold) : jam premium / call ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 3
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF3SqBTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listColdF4C8 Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3SqBTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listColdF4C12 Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF3SqBTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listColdF4C18 Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listColdF3V RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listColdF4C25 Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listColdF4C40 Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4C10000 Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS LIMPE / PAYE PUIS FACE A UNE RELANCE : relance, call (cotes), fold ===
WHEN NOT BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks >= 1 AND AmountToCall > 0 AND Raises = 1
    WHEN listLimpRaiseV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN f$Gen_RawOdds <= 0.2 AND listLimpRaiseC20 Call FORCE
    WHEN f$Gen_RawOdds <= 0.3 AND listLimpRaiseC30 Call FORCE
    WHEN f$Gen_RawOdds <= 1 AND listLimpRaiseC100 Call FORCE
    WHEN Others Fold FORCE
WHEN NOT BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks >= 1 AND AmountToCall > 0 AND Raises = 2
    WHEN listColdF3V AND f$Gen_EffStack <= 30 RaiseMax FORCE
    WHEN listColdF3V RaiseTo (f$Gen_Facing * 2.5) FORCE
    WHEN listColdF3C Call FORCE
    WHEN Others Fold FORCE
// === FACE A UN 5BET OU UN ALL-IN PREFLOP : call selon la profondeur ===
WHEN Raises >= 2
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF3SqBTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listAllinCall8 Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3SqBTNV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listAllinCall12 Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listAllinCall18 Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listAllinCall25 Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listAllinCall40 Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4C25 Call FORCE
    WHEN Others Fold FORCE
WHEN Others
    WHEN AmountToCall > 0 Fold FORCE
    WHEN Others Check FORCE

##f$Gen_PotType##
// Type de pot preflop : 1 = ouvert/limpe, 2 = 3bet, 3 = 4bet ou plus. NumberOfRaisesBeforeFlop ne compte que les relances adverses : on ajoute la notre.
WHEN BotRaisedBeforeFlop AND NumberOfRaisesBeforeFlop >= 2 RETURN 3 FORCE
WHEN BotRaisedBeforeFlop AND NumberOfRaisesBeforeFlop = 1 RETURN 2 FORCE
WHEN NOT BotRaisedBeforeFlop AND NumberOfRaisesBeforeFlop >= 3 RETURN 3 FORCE
WHEN NOT BotRaisedBeforeFlop AND NumberOfRaisesBeforeFlop = 2 RETURN 2 FORCE
WHEN Others RETURN 1 FORCE

##f$Gen_WeChecked##
// Vrai si nous avons checke dans ce tour d'encheres (donc faisons face a une mise apres check)
WHEN BotsActionsOnThisRound = 0 AND BotsActionsOnThisRoundIncludingChecks >= 1 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_RawOdds##
// Equite necessaire pour payer : AmountToCall / (PotSize + AmountToCall)
WHEN AmountToCall <= 0 RETURN 0 FORCE
WHEN Others RETURN AmountToCall / (PotSize + AmountToCall) FORCE

##f$Gen_TexTol##
// Tolerance de call selon la texture : plus bas sur board humide (les tirages arrivent)
WHEN f$Gen_Tex = 1 RETURN 0.88 FORCE
WHEN f$Gen_Tex = 2 RETURN 0.90 FORCE
WHEN f$Gen_Tex = 4 RETURN 0.94 FORCE
WHEN f$Gen_Tex = 5 RETURN 0.97 FORCE
WHEN f$Gen_Tex = 6 RETURN 1.03 FORCE
WHEN f$Gen_Tex = 7 RETURN 1.03 FORCE
WHEN Others RETURN 1 FORCE

##f$Gen_TexBluff##
// Turn/river : credibilite des bluffs selon le board (flush/quinte/paire completes = moins de bluffs)
WHEN betround = flop RETURN 1 FORCE
WHEN nsuitedcommon >= 4 RETURN 0.50 FORCE
WHEN nsuitedcommon >= 3 RETURN 0.70 FORCE
WHEN f$Gen_TxConnected RETURN 0.80 FORCE
WHEN PairOnBoard RETURN 0.90 FORCE
WHEN f$Gen_Tex >= 6 RETURN 1.15 FORCE
WHEN Others RETURN 1 FORCE

##f$Gen_CallTol##
// Tolerance de call globale : type de pot x adversaire x texture
WHEN f$Gen_PotType >= 2 RETURN 1.10 * 1 * f$Gen_TexTol FORCE
WHEN Others RETURN 1 * f$Gen_TexTol FORCE

##f$Gen_PotOdds##
// Cotes du pot ajustees (plus bas = on paye plus large) : sert aux seuils de call postflop
WHEN AmountToCall <= 0 RETURN 0 FORCE
WHEN Others RETURN f$Gen_RawOdds / f$Gen_CallTol FORCE

##f$Gen_BluffMult##
// Facteur sur les bluffs : type de pot x adversaire
WHEN f$Gen_PotType >= 2 RETURN 0.80 * f$Gen_TexBluff FORCE
WHEN Others RETURN f$Gen_TexBluff FORCE

##f$Gen_RRBluff##
// randomround divise par le facteur : frequence effective = frequence x facteur
WHEN Others RETURN randomround / (f$Gen_BluffMult + 0.0001) FORCE

##f$Gen_SPR##
// SPR : tapis restant / pot (plus bas = plus engage)
WHEN PotSize <= 0 RETURN 99 FORCE
WHEN Others RETURN StackSize / PotSize FORCE

##f$Gen_Monster##
// Mains monstrueuses (value maximale)
WHEN HaveStraightFlush RETURN true FORCE
WHEN HaveQuads AND NOT QuadsOnBoard RETURN true FORCE
WHEN HaveFullHouse AND NOT FullHouseOnBoard RETURN true FORCE
WHEN HaveFlush AND NOT FlushOnBoard RETURN true FORCE
WHEN HaveStraight AND NOT StraightOnBoard RETURN true FORCE
WHEN HaveSet RETURN true FORCE
WHEN HaveTrips AND NOT TripsOnBoard RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Strong##
// Mains fortes
WHEN f$Gen_Monster RETURN true FORCE
WHEN HaveTwoPair RETURN true FORCE
WHEN HaveOverPair RETURN true FORCE
WHEN HaveTopPair AND (HaveBestKicker OR HaveSecondBestKicker) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Medium##
// Paires moyennes / top pair kicker faible
WHEN HaveTopPair RETURN true FORCE
WHEN HaveSecondTopPair RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_WeakSD##
// Petites paires (valeur de showdown)
WHEN HavePair RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_StrongDraw##
// Tirages forts (flop/turn)
WHEN (betround < river) AND (HaveFlushDraw OR HaveOpenEndedStraightDraw OR HaveDoubleGutshotDraw) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_NutDraw##
// Tirages nuts / combos : candidats au check-raise et au jam
WHEN (betround < river) AND (HaveNutFlushDraw OR HaveNutStraightDraw OR (HaveFlushDraw AND HaveStraightDraw)) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_WeakDraw##
// Tirages faibles, backdoors, overcards
WHEN (betround < river) AND (HaveInsideStraightDraw OR HaveBackdoorFlushDraw OR Overcards = 2) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Air##
// Rien : ni main faite ni tirage (exclusif avec les autres categories)
WHEN f$Gen_Strong OR f$Gen_Medium OR f$Gen_WeakSD OR f$Gen_StrongDraw OR f$Gen_WeakDraw RETURN false FORCE
WHEN Others RETURN true FORCE

##f$Gen_Blockers##
// Blockers des nuts (bonus de bluff river)
WHEN HaveNutFlushCard RETURN true FORCE
WHEN TopHoleCard = ace RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Scare##
// La carte du turn complete un tirage (dangereuse pour les bluffs)
WHEN (FlushPossibleOnTurn AND NOT FlushPossibleOnFlop) RETURN true FORCE
WHEN (StraightPossibleOnTurn AND NOT StraightPossibleOnFlop) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_GoodBarrelCard##
// Overcard au turn : bonne carte pour le preneur d'initiative
WHEN TurnCardIsOvercardToBoard AND NOT FlushPossibleOnTurn RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_TxConnected##
// Board connecte (tirages quinte possibles). Flop : tirages ouverts ; turn/river : quinte possible
WHEN betround = flop AND (OpenEndedStraightDrawPossibleOnFlop OR ThreeCardStraightOnBoard) RETURN true FORCE
WHEN betround = turn AND (StraightPossible OR OneCardStraightPossible OR OpenEndedStraightDrawOnBoard) RETURN true FORCE
WHEN betround = river AND (StraightPossible OR OneCardStraightPossible) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Tex##
// Texture du board (toutes streets) : 1 monotone/flush, 2 humide, 3 paire, 4 connecte, 5 deux couleurs, 6 As-haut sec, 7 K/Q-haut sec, 8 moyen sec, 9 bas sec
WHEN nsuitedcommon >= 3 RETURN 1 FORCE
WHEN PairOnBoard RETURN 3 FORCE
WHEN nsuitedcommon = 2 AND f$Gen_TxConnected RETURN 2 FORCE
WHEN f$Gen_TxConnected RETURN 4 FORCE
WHEN nsuitedcommon = 2 RETURN 5 FORCE
WHEN BestBoardCard = 14 RETURN 6 FORCE
WHEN BestBoardCard >= 12 RETURN 7 FORCE
WHEN BestBoardCard >= 8 RETURN 8 FORCE
WHEN Others RETURN 9 FORCE

##f$flop##
// OHPG : flop. Blocs : c-bet (agresseur preflop), mise du non-agresseur, relance subie, mise subie.
// Engagement : SPR (tapis / pot) <= 2.5 -> on met le tapis avec les mains fortes
WHEN f$Gen_SPR <= 2.5 AND f$Gen_Monster RaiseMax FORCE
WHEN f$Gen_SPR <= 2.5 AND f$Gen_Strong RaiseMax FORCE
WHEN f$Gen_SPR <= 1.25 AND AmountToCall > 0 AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.45 Call FORCE
WHEN f$Gen_SPR <= 1.25 AND AmountToCall > 0 AND f$Gen_Medium AND f$Gen_PotOdds <= 0.40 Call FORCE
// --- C-BET : nous avons relance preflop et personne n'a mise ---
WHEN AmountToCall = 0 AND BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 0
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Monster RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Strong RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Medium AND randomround < 0.45 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.70 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.28 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_WeakSD AND randomround < 0.23 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Air AND f$Gen_RRBluff < 0.25 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Monster RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Strong RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Medium AND randomround < 0.48 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.75 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.39 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_WeakSD AND randomround < 0.24 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Air AND f$Gen_RRBluff < 0.35 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Monster RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Strong RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Medium AND randomround < 0.58 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.90 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.72 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_WeakSD AND randomround < 0.29 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Air AND f$Gen_RRBluff < 0.65 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Monster RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Strong RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Medium AND randomround < 0.52 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.80 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.50 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_WeakSD AND randomround < 0.26 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Air AND f$Gen_RRBluff < 0.45 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Monster RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Strong RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Medium AND randomround < 0.53 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.82 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.55 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_WeakSD AND randomround < 0.27 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Air AND f$Gen_RRBluff < 0.50 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 6 AND f$Gen_Monster AND randomround < 0.90 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 6 AND f$Gen_Strong RaiseBy 33% FORCE
