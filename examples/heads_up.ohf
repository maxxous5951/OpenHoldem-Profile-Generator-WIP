// --- Nous n'avons pas relancé préflop et personne n'a misé ---
WHEN AmountToCall = 0
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_Monster RaiseBy 43% FORCE
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_Strong RaiseBy 43% FORCE
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_Medium AND randomround < 0.44 RaiseBy 43% FORCE
