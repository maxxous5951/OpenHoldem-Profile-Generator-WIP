// Stack effectif en BB (petit stack entre nous et le plus gros adversaire encore en jeu)
WHEN Others RETURN EffectiveMaxStacksizeOfActiveOpponents FORCE

##f$Gen_IP##
// Vrai si nous agirons en dernier postflop
WHEN StillToActPostflop = 0 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_PotOdds##
// Équité nécessaire pour payer : AmountToCall / (PotSize + AmountToCall)
WHEN AmountToCall <= 0 RETURN 0 FORCE
WHEN Others RETURN AmountToCall / (PotSize + AmountToCall) FORCE

##f$Gen_Multiway##
WHEN Opponents >= 2 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$preflop##
// OHPG : fonction préflop. Chaque bloc WHEN sans action est un scénario ; il se termine par un fold/check.
// === OUVERTURE (personne n'est entré dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    WHEN InEarlyPosition AND listOpenEP RaiseTo 2.5 FORCE
    WHEN InEarlyPosition AND listOpenEPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InMiddlePosition AND listOpenMP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition AND listOpenMPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InCutOff AND listOpenCO RaiseTo 2.3 FORCE
    WHEN InCutOff AND listOpenCOEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN Others Fold FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND InEarlyPosition AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InEarlyPosition AND listIso1EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InEarlyPosition AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InEarlyPosition AND listIso2EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition AND listIso2MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listOpenEP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InEarlyPosition AND listIso3EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InEarlyPosition AND listIso3EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition AND listIso3MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition AND listIso3MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN InBigBlind Check FORCE
    WHEN Others Fold FORCE
// === FACE À UNE OUVERTURE (aucun caller) : 3bet value + bluffs, call, fold ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise = 0
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVEPEPSV RaiseMax FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPV RaiseTo (BetSize * 4) FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPB RaiseTo (BetSize * 4) FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPC Call FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPCp AND randomhand < 0.50 Call FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVMPEPSV RaiseMax FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPEPV RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPEPB RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPEPC Call FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPEPCp AND randomhand < 0.50 Call FORCE
    WHEN InMiddlePosition AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND f$Gen_EffStack <= 20 AND listVMPMPSV RaiseMax FORCE
    WHEN InMiddlePosition AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVMPMPV RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVMPMPB RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVMPMPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVMPMPC Call FORCE
    WHEN InMiddlePosition AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVMPMPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVCOEPSV RaiseMax FORCE
    WHEN InCutOff AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOEPV RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOEPB RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOEPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOEPC Call FORCE
    WHEN InCutOff AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOEPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND f$Gen_EffStack <= 20 AND listVCOMPSV RaiseMax FORCE
    WHEN InCutOff AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVCOMPV RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVCOMPB RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVCOMPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVCOMPC Call FORCE
    WHEN InCutOff AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVCOMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVBTNEPSV RaiseMax FORCE
    WHEN InButton AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPMPV RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBTNEPB RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBTNEPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBTNEPC Call FORCE
    WHEN InButton AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND f$Gen_EffStack <= 20 AND listVBTNMPSV RaiseMax FORCE
    WHEN InButton AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNMPV RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNMPB RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNMPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNMPC Call FORCE
    WHEN InButton AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVBTNCOSV RaiseMax FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOV RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOB RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOC Call FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVSBEPSV RaiseMax FORCE
    WHEN InSmallBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOMPV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBTNMPB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVSBEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVSBEPC Call FORCE
    WHEN InSmallBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVSBEPCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND f$Gen_EffStack <= 20 AND listVSBMPSV RaiseMax FORCE
    WHEN InSmallBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNCOV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVSBMPB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVSBMPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVSBMPC Call FORCE
    WHEN InSmallBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVSBMPCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVSBCOSV RaiseMax FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOC Call FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVSBBTNSV RaiseMax FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBMPB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNC Call FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVBBEPSV RaiseMax FORCE
    WHEN InBigBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVCOEPV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBBEPB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBBEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBBEPC Call FORCE
    WHEN InBigBlind AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVBBEPCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND f$Gen_EffStack <= 20 AND listVBBMPSV RaiseMax FORCE
    WHEN InBigBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVCOMPV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNEPB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBTNEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBBMPC Call FORCE
    WHEN InBigBlind AND (MiddlePosition1Raising OR MiddlePosition2Raising OR MiddlePosition3Raising) AND listVBBMPCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVBTNMPSV RaiseMax FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBTNMPV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBTNEPB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOC Call FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVBBBTNSV RaiseMax FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVSBMPB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNC Call FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND f$Gen_EffStack <= 20 AND listVBBSBSV RaiseMax FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBC Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === SQUEEZE : une ouverture et un ou plusieurs callers ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise >= 1
    WHEN CallsSinceLastRaise = 1 AND InEarlyPosition AND f$Gen_EffStack <= 20 AND listSq1EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InEarlyPosition AND listSq1EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InEarlyPosition AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InEarlyPosition AND listSq1EPC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InEarlyPosition AND listSq1EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition AND f$Gen_EffStack <= 20 AND listSq1EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition AND listSq1EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition AND listSq1EPC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition AND listSq1EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND f$Gen_EffStack <= 20 AND listSq1COSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND f$Gen_EffStack <= 20 AND listSq1COSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND f$Gen_EffStack <= 20 AND listSq1COSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1COSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1SBC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1SBCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND f$Gen_EffStack <= 20 AND listSq1COSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1COSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BBC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BBCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InEarlyPosition AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InEarlyPosition AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InEarlyPosition AND listSq2EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InEarlyPosition AND listSq2EPC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InEarlyPosition AND listSq2EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition AND listSq2EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition AND listSq2EPC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition AND listSq2EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2COC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2COC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2SBC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq1EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2BBC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listIso2MPEdge AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS OUVERT ET FACE À UN 3BET : 4bet value/bluff, call, fold ===
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND NumberOfRaisesBeforeFlop = 1 AND RaisesSinceLastPlay = 1 AND Calls = 0
    WHEN InEarlyPosition AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InEarlyPosition AND listF3EPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InEarlyPosition AND listSq1EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InEarlyPosition AND listF3EPC Call FORCE
    WHEN InEarlyPosition AND listF3EPCp AND randomhand < 0.50 Call FORCE
    WHEN InMiddlePosition AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InMiddlePosition AND listF3EPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition AND listSq1EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition AND listF3MPC Call FORCE
    WHEN InMiddlePosition AND listF3MPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InCutOff AND listF3EPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listSq1EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listF3COC Call FORCE
    WHEN InCutOff AND listF3COCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InButton AND listF3EPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listSq1EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listF3BTNC Call FORCE
    WHEN InButton AND listF3BTNCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InSmallBlind AND listF3EPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listSq1EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listF3SBC Call FORCE
    WHEN InSmallBlind AND listF3SBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND NumberOfRaisesBeforeFlop = 1 AND RaisesSinceLastPlay = 1 AND Calls >= 1
    WHEN InEarlyPosition AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InEarlyPosition AND listF3SqEPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InEarlyPosition AND listSq2EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InEarlyPosition AND listF3SqEPC Call FORCE
    WHEN InEarlyPosition AND listF3SqEPCp AND randomhand < 0.50 Call FORCE
    WHEN InMiddlePosition AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InMiddlePosition AND listF3SqEPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition AND listSq2EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition AND listF3SqMPC Call FORCE
    WHEN InMiddlePosition AND listSq2EPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InCutOff AND listF3SqEPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listSq2EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listF3SqCOC Call FORCE
    WHEN InCutOff AND listIso3COEdge AND randomhand < 0.50 Call FORCE
    WHEN InButton AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InButton AND listF3SqEPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listSq2EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listF3SqBTNC Call FORCE
    WHEN InButton AND listF3SqBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InSmallBlind AND listF3SqEPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listSq2EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listF3SqSBC Call FORCE
    WHEN InSmallBlind AND listF3SqSBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === OUVERTURE + 3BET DEVANT NOUS (cold) : 4bet très serré ou call ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 2
    WHEN listColdF3V RaiseTo (BetSize * 2.5) FORCE
    WHEN listColdF3C Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS 3BETÉ ET FACE À UN 4BET : jam value/bluff, call, fold ===
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND NumberOfRaisesBeforeFlop = 2 AND RaisesSinceLastPlay = 1
    WHEN f$Gen_EffStack > 0 AND f$Gen_EffStack <= 8 AND listSq2EPSV RaiseMax FORCE
    WHEN f$Gen_EffStack > 0 AND f$Gen_EffStack <= 8 AND listSq2EPB RaiseMax FORCE
    WHEN f$Gen_EffStack > 0 AND f$Gen_EffStack <= 8 AND listF4S8C Call FORCE
    WHEN f$Gen_EffStack > 0 AND f$Gen_EffStack <= 8 AND listF4S8Cp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack > 8 AND f$Gen_EffStack <= 12 AND listF3EPV RaiseMax FORCE
    WHEN f$Gen_EffStack > 8 AND f$Gen_EffStack <= 12 AND listSq2EPB RaiseMax FORCE
    WHEN f$Gen_EffStack > 8 AND f$Gen_EffStack <= 12 AND listF4S12C Call FORCE
    WHEN f$Gen_EffStack > 8 AND f$Gen_EffStack <= 12 AND listIso3COEdge AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack > 12 AND f$Gen_EffStack <= 18 AND listF3EPV RaiseMax FORCE
    WHEN f$Gen_EffStack > 12 AND f$Gen_EffStack <= 18 AND listSq2EPB RaiseMax FORCE
    WHEN f$Gen_EffStack > 12 AND f$Gen_EffStack <= 18 AND listF4S18C Call FORCE
    WHEN f$Gen_EffStack > 12 AND f$Gen_EffStack <= 18 AND listIso3MPEdge AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack > 18 AND f$Gen_EffStack <= 25 AND listF4S25V RaiseMax FORCE
    WHEN f$Gen_EffStack > 18 AND f$Gen_EffStack <= 25 AND listSq2EPB RaiseMax FORCE
    WHEN f$Gen_EffStack > 18 AND f$Gen_EffStack <= 25 AND listF4S25C Call FORCE
    WHEN f$Gen_EffStack > 18 AND f$Gen_EffStack <= 25 AND listF3EPCp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack > 25 AND f$Gen_EffStack <= 40 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack > 25 AND f$Gen_EffStack <= 40 AND listF4S40B RaiseMax FORCE
    WHEN f$Gen_EffStack > 25 AND f$Gen_EffStack <= 40 AND listF4S40C Call FORCE
    WHEN f$Gen_EffStack > 25 AND f$Gen_EffStack <= 40 AND listF4S40Cp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack > 40 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack > 40 AND listF4S40B RaiseMax FORCE
    WHEN f$Gen_EffStack > 40 AND listF3SqEPC Call FORCE
    WHEN f$Gen_EffStack > 40 AND listF4S10000Cp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === 4BET DEVANT NOUS (cold) : jam premium / call ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 3
    WHEN f$Gen_EffStack > 0 AND f$Gen_EffStack <= 8 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack > 0 AND f$Gen_EffStack <= 8 AND listColdF4C8 Call FORCE
    WHEN f$Gen_EffStack > 8 AND f$Gen_EffStack <= 12 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack > 8 AND f$Gen_EffStack <= 12 AND listColdF4C12 Call FORCE
    WHEN f$Gen_EffStack > 12 AND f$Gen_EffStack <= 18 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack > 12 AND f$Gen_EffStack <= 18 AND listColdF4C18 Call FORCE
    WHEN f$Gen_EffStack > 18 AND f$Gen_EffStack <= 25 AND listColdF3V RaiseMax FORCE
    WHEN f$Gen_EffStack > 18 AND f$Gen_EffStack <= 25 AND listColdF4C25 Call FORCE
    WHEN f$Gen_EffStack > 25 AND f$Gen_EffStack <= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack > 25 AND f$Gen_EffStack <= 40 AND listColdF4C40 Call FORCE
    WHEN f$Gen_EffStack > 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack > 40 AND listColdF4C10000 Call FORCE
    WHEN Others Fold FORCE
// === FACE À UN 5BET OU UN ALL-IN PRÉFLOP : call selon la profondeur ===
WHEN Raises >= 2
    WHEN f$Gen_EffStack > 0 AND f$Gen_EffStack <= 8 AND listVBBSBV Call FORCE
    WHEN f$Gen_EffStack > 8 AND f$Gen_EffStack <= 12 AND listVBTNCOV Call FORCE
    WHEN f$Gen_EffStack > 12 AND f$Gen_EffStack <= 18 AND listVCOMPV Call FORCE
    WHEN f$Gen_EffStack > 18 AND f$Gen_EffStack <= 25 AND listVMPEPV Call FORCE
    WHEN f$Gen_EffStack > 25 AND f$Gen_EffStack <= 40 AND listAllinCall40 Call FORCE
    WHEN f$Gen_EffStack > 40 AND listSq1COSV Call FORCE
    WHEN Others Fold FORCE
WHEN Others
    WHEN AmountToCall > 0 Fold FORCE
    WHEN Others Check FORCE

##f$Gen_Monster##
// Mains monstrueuses (value maximale)
WHEN HaveStraightFlush RETURN true FORCE
WHEN HaveQuads AND NOT QuadsOnBoard RETURN true FORCE
WHEN HaveFullHouse AND NOT FullHouseOnBoard RETURN true FORCE
WHEN HaveFlush AND NOT FlushOnBoard RETURN true FORCE
WHEN HaveStraight AND NOT StraightOnBoard RETURN true FORCE
WHEN HaveSet RETURN true FORCE
WHEN HaveTrips AND NOT TripsOnBoard RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Strong##
// Mains fortes
WHEN f$Gen_Monster RETURN true FORCE
WHEN HaveTwoPair RETURN true FORCE
WHEN HaveOverPair RETURN true FORCE
WHEN HaveTopPair AND (HaveBestKicker OR HaveSecondBestKicker) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Medium##
// Paires moyennes / top pair kicker faible
WHEN HaveTopPair RETURN true FORCE
WHEN HaveSecondTopPair RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_WeakSD##
// Petites paires (valeur de showdown)
WHEN HavePair RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_StrongDraw##
// Tirages forts (flop/turn)
WHEN (betround < river) AND (HaveFlushDraw OR HaveOpenEndedStraightDraw OR HaveDoubleGutshotDraw) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_NutDraw##
// Tirages nuts / combos : candidats au check-raise et au jam
WHEN (betround < river) AND (HaveNutFlushDraw OR HaveNutStraightDraw OR (HaveFlushDraw AND HaveStraightDraw)) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_WeakDraw##
// Tirages faibles, backdoors, overcards
WHEN (betround < river) AND (HaveInsideStraightDraw OR HaveBackdoorFlushDraw OR Overcards = 2) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Air##
// Rien : ni main faite ni tirage (exclusif avec les autres catégories)
WHEN f$Gen_Strong OR f$Gen_Medium OR f$Gen_WeakSD OR f$Gen_StrongDraw OR f$Gen_WeakDraw RETURN false FORCE
WHEN Others RETURN true FORCE

##f$Gen_Blockers##
// Blockers des nuts (bonus de bluff river)
WHEN HaveNutFlushCard RETURN true FORCE
WHEN TopHoleCard = ace RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Scare##
// La carte du turn complète un tirage (dangereuse pour les bluffs)
WHEN (FlushPossibleOnTurn AND NOT FlushPossibleOnFlop) RETURN true FORCE
WHEN (StraightPossibleOnTurn AND NOT StraightPossibleOnFlop) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_GoodBarrelCard##
// Overcard au turn : bonne carte pour le preneur d'initiative
WHEN TurnCardIsOvercardToBoard AND NOT FlushPossibleOnTurn RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Tex##
// Texture du flop : 1 monotone, 2 humide, 3 pairé, 4 haut sec, 5 bas sec, 6 sec
WHEN nsuitedcommon >= 3 RETURN 1 FORCE
WHEN (nsuitedcommon = 2 AND (StraightPossible OR OpenEndedStraightDrawPossibleOnFlop)) OR OpenEndedStraightDrawPossibleOnFlop OR ThreeCardStraightOnBoard RETURN 2 FORCE
WHEN PairOnBoard RETURN 3 FORCE
WHEN BestBoardCard >= 13 RETURN 4 FORCE
WHEN BestBoardCard <= 9 RETURN 5 FORCE
WHEN Others RETURN 6 FORCE

##f$flop##
// OHPG : flop. Blocs : c-bet (agresseur préflop), mise du non-agresseur, relance subie, mise subie.
// --- C-BET : nous avons relancé préflop et personne n'a misé ---
WHEN AmountToCall = 0 AND BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 0
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Monster RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Strong RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Medium AND randomround < 0.45 RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_StrongDraw AND randomround < 0.70 RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_WeakDraw AND randomround < 0.28 RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_WeakSD AND randomround < 0.23 RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Air AND randomround < 0.25 RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 Check FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Monster RaiseBy 66% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Strong RaiseBy 66% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Medium AND randomround < 0.48 RaiseBy 66% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_StrongDraw AND randomround < 0.75 RaiseBy 66% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_WeakDraw AND randomround < 0.39 RaiseBy 66% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_WeakSD AND randomround < 0.24 RaiseBy 66% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Air AND randomround < 0.35 RaiseBy 66% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 Check FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Monster RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Strong RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Medium AND randomround < 0.58 RaiseBy 33% FORCE
