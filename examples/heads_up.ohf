    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Strong RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Medium AND randomround < 0.52 RaiseBy 33% FORCE
