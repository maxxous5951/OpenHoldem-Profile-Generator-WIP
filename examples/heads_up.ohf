    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 6 AND f$Gen_StrongDraw AND randomround < 0.92 RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 6 AND f$Gen_WeakDraw AND randomround < 0.77 RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 6 AND f$Gen_WeakSD AND randomround < 0.30 RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 6 AND f$Gen_Air AND randomround < 0.70 RaiseBy 33% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 6 Check FORCE
    WHEN NOT f$Gen_Multiway AND NOT f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Monster RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND NOT f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Strong RaiseBy 40% FORCE
    WHEN NOT f$Gen_Multiway AND NOT f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Medium AND randomround < 0.25 RaiseBy 40% FORCE
