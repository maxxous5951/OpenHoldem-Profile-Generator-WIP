// --- On fait face a une mise (c-bet adverse, donk, probe...) ---
WHEN AmountToCall > 0
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.660 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.858 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.370 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.481 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.190 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.247 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Air AND f$Gen_Blockers AND f$Gen_RRBluff < 0.04 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway Fold FORCE
    WHEN f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.561 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.729 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.315 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.409 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.162 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.210 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Air AND f$Gen_Blockers AND f$Gen_RRBluff < 0.04 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway Fold FORCE
