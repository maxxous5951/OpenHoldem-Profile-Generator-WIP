// Stack effectif en BB (petit stack entre nous et le plus gros adversaire encore en jeu)
WHEN Others RETURN EffectiveMaxStacksizeOfActiveOpponents FORCE

##f$Gen_IP##
// Vrai si nous agirons en dernier postflop
WHEN StillToActPostflop = 0 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Multiway##
WHEN Opponents >= 2 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$preflop##
// OHPG : fonction preflop. Chaque bloc WHEN sans action est un scenario ; il se termine par un fold/check.
// === OUVERTURE (personne n'est entre dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    WHEN InMiddlePosition2 AND listOpenEP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition2 AND listOpenEPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InMiddlePosition3 AND listOpenMP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition3 AND listOpenMPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InCutOff AND listOpenCO RaiseTo 2.3 FORCE
    WHEN InCutOff AND listOpenCOEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenSB RaiseTo 3 FORCE
    WHEN InSmallBlind AND listOpenSBEdge AND randomhand < 0.50 RaiseTo 3 FORCE
    WHEN Others Fold FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND InMiddlePosition2 AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition2 AND listIso1EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition3 AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition3 AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition2 AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition2 AND listIso2EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition3 AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition3 AND listIso2MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition2 AND listIso3EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition2 AND listIso3EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition3 AND listIso3MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition3 AND listIso3MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso3CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso3BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso3BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN InBigBlind Check FORCE
    WHEN Others Fold FORCE
// === FACE A UNE OUVERTURE (aucun caller) : 3bet value + bluffs, call, fold ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise = 0
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVMPEPSV RaiseMax FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPV RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPB RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPC Call FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVCOEPSV RaiseMax FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPV RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPB RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPC Call FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVCOMPSV RaiseMax FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPV RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPB RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPC Call FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVBTNEPSV RaiseMax FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPV RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPB RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPC Call FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVCOMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVBTNMPSV RaiseMax FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPV RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPB RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPC Call FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVBTNCOSV RaiseMax FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOV RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOB RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOBp AND randomhand < 0.50 RaiseTo (BetSize * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOC Call FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVSBEPSV RaiseMax FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVCOMPV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVBTNMPB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPC Call FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVBTNCOSV RaiseMax FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVBTNCOV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVBTNCOB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPC Call FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVSBCOSV RaiseMax FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOC Call FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVSBBTNSV RaiseMax FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNV RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNB RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNC Call FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVCOEPSV RaiseMax FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVCOEPV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPC Call FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVBBMPSV RaiseMax FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVCOMPV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBTNEPB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBTNEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBBMPC Call FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBBMPCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVBBCOSV RaiseMax FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBTNMPV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOC Call FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVBBBTNSV RaiseMax FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBTNCOB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVSBMPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNC Call FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND f$Gen_EffStack <= 20 AND listVBBSBSV RaiseMax FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBV RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVSBCOB RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBC Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === SQUEEZE : une ouverture et un ou plusieurs callers ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise >= 1
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition2 AND f$Gen_EffStack <= 20 AND listSq1EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition2 AND listSq1EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition2 AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition2 AND listSq1EPBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition2 AND listSq1EPC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition2 AND listSq1EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND f$Gen_EffStack <= 20 AND listSq1EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND listSq1EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND listSq1EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND listSq1EPBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND listSq1EPC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND listSq1EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND f$Gen_EffStack <= 20 AND listVMPEPV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listVMPEPV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InCutOff AND listSq1COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND f$Gen_EffStack <= 20 AND listVMPEPV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listVMPEPV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InButton AND listSq1COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND f$Gen_EffStack <= 20 AND listVMPEPV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listVMPEPV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1SBC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InSmallBlind AND listSq1SBCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND f$Gen_EffStack <= 20 AND listVMPEPV RaiseMax FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listVMPEPV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BBC Call FORCE
    WHEN CallsSinceLastRaise = 1 AND InBigBlind AND listSq1BBCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition2 AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition2 AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition2 AND listSq2EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition2 AND listSq2EPC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition2 AND listSq2EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition3 AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition3 AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition3 AND listSq2EPB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition3 AND listSq2EPC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InMiddlePosition3 AND listSq2EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2COC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InCutOff AND listSq2COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2COC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InButton AND listSq2COCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq2SBC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InSmallBlind AND listSq1EPCp AND randomhand < 0.50 Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND f$Gen_EffStack <= 20 AND listSq2EPSV RaiseMax FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2EPSV RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2COB RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2COBp AND randomhand < 0.50 RaiseTo (BetSize * 3.8 + BetSize * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listSq2BBC Call FORCE
    WHEN CallsSinceLastRaise >= 2 AND InBigBlind AND listIso3EPEdge AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS OUVERT ET FACE A UN 3BET : 4bet value/bluff, call, fold ===
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND NumberOfRaisesBeforeFlop = 1 AND RaisesSinceLastPlay = 1 AND Calls = 0
    WHEN InMiddlePosition2 AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InMiddlePosition2 AND listF3EPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition2 AND listSq1EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition2 AND listSq1EPBp AND randomhand < 0.50 RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition2 AND listF3EPC Call FORCE
    WHEN InMiddlePosition2 AND listF3EPCp AND randomhand < 0.50 Call FORCE
    WHEN InMiddlePosition3 AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InMiddlePosition3 AND listF3EPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition3 AND listSq1EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition3 AND listSq1EPBp AND randomhand < 0.50 RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition3 AND listF3MPC Call FORCE
    WHEN InMiddlePosition3 AND listF3MPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InCutOff AND listF3EPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listSq1EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listSq1EPBp AND randomhand < 0.50 RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listF3COC Call FORCE
    WHEN InCutOff AND listF3COCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InButton AND listF3EPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listSq1EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listSq1EPBp AND randomhand < 0.50 RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listF3BTNC Call FORCE
    WHEN InButton AND listF3BTNCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND f$Gen_EffStack <= 30 AND listF3EPSV RaiseMax FORCE
    WHEN InSmallBlind AND listF3EPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listSq1EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listSq1EPBp AND randomhand < 0.50 RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listF3SBC Call FORCE
    WHEN InSmallBlind AND listF3SBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND NumberOfRaisesBeforeFlop = 1 AND RaisesSinceLastPlay = 1 AND Calls >= 1
    WHEN InMiddlePosition2 AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InMiddlePosition2 AND listF3SqEPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition2 AND listSq2EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition2 AND listF3SqEPC Call FORCE
    WHEN InMiddlePosition2 AND listF3SqEPCp AND randomhand < 0.50 Call FORCE
    WHEN InMiddlePosition3 AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InMiddlePosition3 AND listF3SqEPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition3 AND listSq2EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InMiddlePosition3 AND listF3SqMPC Call FORCE
    WHEN InMiddlePosition3 AND listF3SqMPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InCutOff AND listF3SqEPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listSq2EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InCutOff AND listF3SqCOC Call FORCE
    WHEN InCutOff AND listF3SqCOCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InButton AND listF3SqEPV RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listSq2EPB RaiseTo (BetSize * 2.2) FORCE
    WHEN InButton AND listF3SqBTNC Call FORCE
    WHEN InButton AND listF3SqBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND f$Gen_EffStack <= 30 AND listF3SqEPSV RaiseMax FORCE
    WHEN InSmallBlind AND listF3SqEPV RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listSq2EPB RaiseTo (BetSize * 2.5) FORCE
    WHEN InSmallBlind AND listF3SqCOC Call FORCE
    WHEN InSmallBlind AND listF3SqSBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === OUVERTURE + 3BET DEVANT NOUS (cold) : 4bet tres serre ou call ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 2
    WHEN listColdF3V RaiseTo (BetSize * 2.5) FORCE
    WHEN listColdF3C Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS 3BETE ET FACE A UN 4BET : jam value/bluff, call, fold ===
WHEN BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 1 AND NumberOfRaisesBeforeFlop = 2 AND RaisesSinceLastPlay = 1
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listSq2EPSV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listSq2EPB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF4S8C Call FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF3SqCOCp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3EPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listSq2EPB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3MPC Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3MPCp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF3EPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listSq2EPB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF3EPC Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF3EPCp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listF4S25V RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listSq1EPB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listF4S25C Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listF4S25Cp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listSq1EPB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listF4S40C Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listF4S40Cp AND randomhand < 0.50 Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listSq1EPB RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listF4S10000C Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listF4S10000Cp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === 4BET DEVANT NOUS (cold) : jam premium / call ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 3
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listColdF4C8 Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listColdF4C12 Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listColdF4C18 Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listColdF3V RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listColdF4C25 Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listColdF4C40 Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4C10000 Call FORCE
    WHEN Others Fold FORCE
// === NOUS AVONS LIMPE / PAYE PUIS FACE A UNE RELANCE : relance, call (cotes), fold ===
WHEN NOT BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks >= 1 AND AmountToCall > 0 AND Raises = 1
    WHEN listLimpRaiseV RaiseTo (BetSize * 4) FORCE
    WHEN f$Gen_RawOdds <= 0.2 AND listLimpRaiseC20 Call FORCE
    WHEN f$Gen_RawOdds <= 0.3 AND listLimpRaiseC30 Call FORCE
    WHEN f$Gen_RawOdds <= 1 AND listLimpRaiseC100 Call FORCE
    WHEN Others Fold FORCE
WHEN NOT BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks >= 1 AND AmountToCall > 0 AND Raises = 2
    WHEN listColdF3V AND f$Gen_EffStack <= 30 RaiseMax FORCE
    WHEN listColdF3V RaiseTo (BetSize * 2.5) FORCE
    WHEN listColdF3C Call FORCE
    WHEN Others Fold FORCE
// === FACE A UN 5BET OU UN ALL-IN PREFLOP : call selon la profondeur ===
WHEN Raises >= 2
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 0 AND f$Gen_EffStack <= 8 AND listAllinCall8 Call FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listF3SqEPV RaiseMax FORCE
    WHEN f$Gen_EffStack >= 8 AND f$Gen_EffStack <= 12 AND listAllinCall12 Call FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 12 AND f$Gen_EffStack <= 18 AND listAllinCall18 Call FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 18 AND f$Gen_EffStack <= 25 AND listAllinCall25 Call FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 25 AND f$Gen_EffStack <= 40 AND listAllinCall40 Call FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4J40 RaiseMax FORCE
    WHEN f$Gen_EffStack >= 40 AND listColdF4C25 Call FORCE
    WHEN Others Fold FORCE
WHEN Others
    WHEN AmountToCall > 0 Fold FORCE
    WHEN Others Check FORCE

##f$Gen_PotType##
// Type de pot preflop : 1 = ouvert/limpe, 2 = 3bet, 3 = 4bet ou plus
WHEN NumberOfRaisesBeforeFlop >= 3 RETURN 3 FORCE
WHEN NumberOfRaisesBeforeFlop = 2 RETURN 2 FORCE
WHEN Others RETURN 1 FORCE

##f$Gen_WeChecked##
// Vrai si nous avons checke dans ce tour d'encheres (donc faisons face a une mise apres check)
WHEN BotsActionsOnThisRound = 0 AND BotsActionsOnThisRoundIncludingChecks >= 1 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_RawOdds##
// Equite necessaire pour payer : AmountToCall / (PotSize + AmountToCall)
WHEN AmountToCall <= 0 RETURN 0 FORCE
WHEN Others RETURN AmountToCall / (PotSize + AmountToCall) FORCE

##f$Gen_TexTol##
// Tolerance de call selon la texture : plus bas sur board humide (les tirages arrivent)
WHEN f$Gen_Tex = 1 RETURN 0.88 FORCE
WHEN f$Gen_Tex = 2 RETURN 0.90 FORCE
WHEN f$Gen_Tex = 4 RETURN 0.94 FORCE
WHEN f$Gen_Tex = 5 RETURN 0.97 FORCE
WHEN f$Gen_Tex = 6 RETURN 1.03 FORCE
WHEN f$Gen_Tex = 7 RETURN 1.03 FORCE
WHEN Others RETURN 1 FORCE

##f$Gen_TexBluff##
// Turn/river : credibilite des bluffs selon le board (flush/quinte/paire completes = moins de bluffs)
WHEN betround = flop RETURN 1 FORCE
WHEN nsuitedcommon >= 4 RETURN 0.50 FORCE
WHEN nsuitedcommon >= 3 RETURN 0.70 FORCE
WHEN f$Gen_TxConnected RETURN 0.80 FORCE
WHEN PairOnBoard RETURN 0.90 FORCE
WHEN f$Gen_Tex >= 6 RETURN 1.15 FORCE
WHEN Others RETURN 1 FORCE

##f$Gen_CallTol##
// Tolerance de call globale : type de pot x adversaire x texture
WHEN f$Gen_PotType >= 2 RETURN 1.10 * 1 * f$Gen_TexTol FORCE
WHEN Others RETURN 1 * f$Gen_TexTol FORCE

##f$Gen_PotOdds##
// Cotes du pot ajustees (plus bas = on paye plus large) : sert aux seuils de call postflop
WHEN AmountToCall <= 0 RETURN 0 FORCE
WHEN Others RETURN f$Gen_RawOdds / f$Gen_CallTol FORCE

##f$Gen_BluffMult##
// Facteur sur les bluffs : type de pot x adversaire
WHEN f$Gen_PotType >= 2 RETURN 0.80 * f$Gen_TexBluff FORCE
WHEN Others RETURN f$Gen_TexBluff FORCE

##f$Gen_RRBluff##
// randomround divise par le facteur : frequence effective = frequence x facteur
WHEN Others RETURN randomround / (f$Gen_BluffMult + 0.0001) FORCE

##f$Gen_SPR##
// SPR : tapis restant / pot (plus bas = plus engage)
WHEN PotSize <= 0 RETURN 99 FORCE
WHEN Others RETURN StackSize / PotSize FORCE

##f$Gen_Monster##
// Mains monstrueuses (value maximale)
WHEN HaveStraightFlush RETURN true FORCE
WHEN HaveQuads AND NOT QuadsOnBoard RETURN true FORCE
WHEN HaveFullHouse AND NOT FullHouseOnBoard RETURN true FORCE
WHEN HaveFlush AND NOT FlushOnBoard RETURN true FORCE
WHEN HaveStraight AND NOT StraightOnBoard RETURN true FORCE
WHEN HaveSet RETURN true FORCE
WHEN HaveTrips AND NOT TripsOnBoard RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Strong##
// Mains fortes
WHEN f$Gen_Monster RETURN true FORCE
WHEN HaveTwoPair RETURN true FORCE
WHEN HaveOverPair RETURN true FORCE
WHEN HaveTopPair AND (HaveBestKicker OR HaveSecondBestKicker) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Medium##
// Paires moyennes / top pair kicker faible
WHEN HaveTopPair RETURN true FORCE
WHEN HaveSecondTopPair RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_WeakSD##
// Petites paires (valeur de showdown)
WHEN HavePair RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_StrongDraw##
// Tirages forts (flop/turn)
WHEN (betround < river) AND (HaveFlushDraw OR HaveOpenEndedStraightDraw OR HaveDoubleGutshotDraw) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_NutDraw##
// Tirages nuts / combos : candidats au check-raise et au jam
WHEN (betround < river) AND (HaveNutFlushDraw OR HaveNutStraightDraw OR (HaveFlushDraw AND HaveStraightDraw)) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_WeakDraw##
// Tirages faibles, backdoors, overcards
WHEN (betround < river) AND (HaveInsideStraightDraw OR HaveBackdoorFlushDraw OR Overcards = 2) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Air##
// Rien : ni main faite ni tirage (exclusif avec les autres categories)
WHEN f$Gen_Strong OR f$Gen_Medium OR f$Gen_WeakSD OR f$Gen_StrongDraw OR f$Gen_WeakDraw RETURN false FORCE
WHEN Others RETURN true FORCE

##f$Gen_Blockers##
// Blockers des nuts (bonus de bluff river)
WHEN HaveNutFlushCard RETURN true FORCE
WHEN TopHoleCard = ace RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Scare##
// La carte du turn complete un tirage (dangereuse pour les bluffs)
WHEN (FlushPossibleOnTurn AND NOT FlushPossibleOnFlop) RETURN true FORCE
WHEN (StraightPossibleOnTurn AND NOT StraightPossibleOnFlop) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_GoodBarrelCard##
// Overcard au turn : bonne carte pour le preneur d'initiative
WHEN TurnCardIsOvercardToBoard AND NOT FlushPossibleOnTurn RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_TxConnected##
// Board connecte (tirages quinte possibles). Flop : tirages ouverts ; turn/river : quinte possible
WHEN betround = flop AND (OpenEndedStraightDrawPossibleOnFlop OR ThreeCardStraightOnBoard) RETURN true FORCE
WHEN betround = turn AND (StraightPossible OR OneCardStraightPossible OR OpenEndedStraightDrawOnBoard) RETURN true FORCE
WHEN betround = river AND (StraightPossible OR OneCardStraightPossible) RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Tex##
// Texture du board (toutes streets) : 1 monotone/flush, 2 humide, 3 paire, 4 connecte, 5 deux couleurs, 6 As-haut sec, 7 K/Q-haut sec, 8 moyen sec, 9 bas sec
WHEN nsuitedcommon >= 3 RETURN 1 FORCE
WHEN PairOnBoard RETURN 3 FORCE
WHEN nsuitedcommon = 2 AND f$Gen_TxConnected RETURN 2 FORCE
WHEN f$Gen_TxConnected RETURN 4 FORCE
WHEN nsuitedcommon = 2 RETURN 5 FORCE
WHEN BestBoardCard = 14 RETURN 6 FORCE
WHEN BestBoardCard >= 12 RETURN 7 FORCE
WHEN BestBoardCard >= 8 RETURN 8 FORCE
WHEN Others RETURN 9 FORCE

##f$flop##
// OHPG : flop. Blocs : c-bet (agresseur preflop), mise du non-agresseur, relance subie, mise subie.
// Engagement : SPR (tapis / pot) <= 2.5 -> on met le tapis avec les mains fortes
WHEN f$Gen_SPR <= 2.5 AND f$Gen_Monster RaiseMax FORCE
WHEN f$Gen_SPR <= 2.5 AND f$Gen_Strong RaiseMax FORCE
WHEN f$Gen_SPR <= 1.25 AND AmountToCall > 0 AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.45 Call FORCE
WHEN f$Gen_SPR <= 1.25 AND AmountToCall > 0 AND f$Gen_Medium AND f$Gen_PotOdds <= 0.40 Call FORCE
// --- C-BET : nous avons relance preflop et personne n'a mise ---
WHEN AmountToCall = 0 AND BotRaisedBeforeFlop AND BotsActionsOnThisRoundIncludingChecks = 0
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Monster RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Strong RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Medium AND randomround < 0.45 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.91 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.56 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_WeakSD AND randomround < 0.23 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 AND f$Gen_Air AND f$Gen_RRBluff < 0.51 RaiseBy 40% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 1 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Monster RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Strong RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Medium AND randomround < 0.48 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.98 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.71 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_WeakSD AND randomround < 0.24 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 AND f$Gen_Air AND f$Gen_RRBluff < 0.65 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 2 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Monster RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Strong RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Medium AND randomround < 0.58 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_StrongDraw RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_WeakDraw RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_WeakSD AND randomround < 0.29 RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 AND f$Gen_Air RaiseBy 33% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 3 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Monster RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Strong RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Medium AND randomround < 0.52 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_StrongDraw RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.86 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_WeakSD AND randomround < 0.26 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 AND f$Gen_Air AND f$Gen_RRBluff < 0.78 RaiseBy 66% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 4 Check FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Monster RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Strong RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Medium AND randomround < 0.53 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_StrongDraw RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.94 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_WeakSD AND randomround < 0.27 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 AND f$Gen_Air AND f$Gen_RRBluff < 0.85 RaiseBy 49% FORCE
    WHEN f$Gen_PotType = 1 AND NOT f$Gen_Multiway AND f$Gen_IP AND f$Gen_Tex = 5 Check FORCE
