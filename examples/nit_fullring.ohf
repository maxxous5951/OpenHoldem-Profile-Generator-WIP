    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.275 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.357 AND randomround < 0.50 Call FORCE
