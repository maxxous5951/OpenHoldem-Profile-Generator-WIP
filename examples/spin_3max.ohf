    WHEN NOT f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_RRBluff < 0.06 RaiseBy 66% FORCE
    WHEN Others Check FORCE
// --- On nous met all-in : call ou fold (pas de relance possible) ---
WHEN AmountToCall > 0 AND AmountToCall >= StackSize * 0.9
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.660 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.858 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.380 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.494 AND randomround < 0.50 Call FORCE
