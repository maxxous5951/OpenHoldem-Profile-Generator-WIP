    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.133 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway Fold FORCE
// --- Nous avons checke et on mise devant nous : plan de check-raise ---
WHEN AmountToCall > 0 AND f$Gen_WeChecked
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.65 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster Call FORCE
