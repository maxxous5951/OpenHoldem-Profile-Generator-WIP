// === OUVERTURE (personne n'est entre dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    // Zone open-jam : stack effectif <= 20 BB, mains premium all-in (au-dessus, ouverture normale)
    WHEN InButton AND f$Gen_EffStackFirstIn >= 0 AND f$Gen_EffStackFirstIn <= 10 AND listOpenJamBTN10 RaiseMax FORCE
    WHEN InButton AND f$Gen_EffStackFirstIn >= 10 AND f$Gen_EffStackFirstIn <= 20 AND listOpenJamBTN20 RaiseMax FORCE
