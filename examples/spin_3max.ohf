    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.102 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.133 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway Fold FORCE

##f$river##
// OHPG : river. Value fine, bluffs avec blockers, probe, defense par cotes (MDF).
// Engagement : SPR (tapis / pot) <= 2.5 -> on met le tapis avec les mains fortes
WHEN f$Gen_SPR <= 2.5 AND f$Gen_Monster RaiseMax FORCE
WHEN f$Gen_SPR <= 2.5 AND NOT f$Gen_Multiway AND f$Gen_Strong RaiseMax FORCE
WHEN f$Gen_SPR <= 1.25 AND AmountToCall > 0 AND f$Gen_Medium AND f$Gen_PotOdds <= 0.40 Call FORCE
// --- 3e BARREL : nous avons mise au turn ---
WHEN AmountToCall = 0 AND BotRaisedOnTurn
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_IP RaiseBy 110% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster RaiseBy 70% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong RaiseBy 70% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Medium AND randomround < 0.60 RaiseBy 45% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Blockers AND f$Gen_Air AND f$Gen_RRBluff < 0.53 RaiseBy 70% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Air AND f$Gen_RRBluff < 0.28 RaiseBy 70% FORCE
    WHEN NOT f$Gen_Multiway Check FORCE
    WHEN f$Gen_Multiway AND HaveNuts AND f$Gen_IP RaiseBy 110% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster RaiseBy 70% FORCE
