// === BB FACE A UN LIMP DU SB (3-max / heads-up) : relance ou check ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 1 AND InBigBlind AND SmallBlindCalling
    WHEN listIsoBBvsSBlimp RaiseTo 3 FORCE
    WHEN listIsoBBvsSBlimpEdge AND randomhand < 0.50 RaiseTo 3 FORCE
    WHEN Others Check FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
