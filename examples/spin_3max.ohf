    WHEN f$Gen_Multiway AND f$Gen_Air AND f$Gen_RRBluff < 0.11 RaiseBy 70% FORCE
    WHEN f$Gen_Multiway Check FORCE
    WHEN Others Check FORCE
// --- Sans mise devant nous : value / probe / bluff ---
WHEN AmountToCall = 0
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND HaveNuts RaiseBy 110% FORCE
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_Monster RaiseBy 70% FORCE
