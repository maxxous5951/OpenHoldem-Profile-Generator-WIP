    WHEN f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND randomround < 0.16 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.561 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.729 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_NutDraw AND f$Gen_RRBluff < 0.15 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_RRBluff < 0.07 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.323 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.420 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.348 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.453 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.196 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.254 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.102 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.133 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway Fold FORCE
// --- On nous relance apres notre mise ---
WHEN AmountToCall > 0 AND RaisesSinceLastPlay >= 1 AND BotsActionsOnThisRoundIncludingChecks >= 1
    WHEN HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN f$Gen_Monster Call FORCE
    WHEN f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN f$Gen_Strong AND f$Gen_PotOdds <= 0.495 Call FORCE
    WHEN f$Gen_Strong AND f$Gen_PotOdds <= 0.643 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_NutDraw AND f$Gen_RRBluff < 0.15 RaiseBy 100% FORCE
    WHEN f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.285 Call FORCE
    WHEN f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.371 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Medium AND f$Gen_PotOdds <= 0.307 Call FORCE
    WHEN f$Gen_Medium AND f$Gen_PotOdds <= 0.400 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_WeakSD AND f$Gen_PotOdds <= 0.173 Call FORCE
    WHEN f$Gen_WeakSD AND f$Gen_PotOdds <= 0.224 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.090 Call FORCE
    WHEN f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.117 AND randomround < 0.50 Call FORCE
    WHEN Others Fold FORCE
// --- On fait face a une mise (c-bet adverse, donk, probe...) ---
WHEN AmountToCall > 0
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.660 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.858 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_NutDraw AND f$Gen_RRBluff < 0.15 RaiseBy 100% FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.380 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_StrongDraw AND f$Gen_PotOdds <= 0.494 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.410 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_Medium AND f$Gen_PotOdds <= 0.533 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.230 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakSD AND f$Gen_PotOdds <= 0.299 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.120 Call FORCE
    WHEN NOT f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.156 AND randomround < 0.50 Call FORCE
    WHEN NOT f$Gen_Multiway Fold FORCE
    WHEN f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Monster Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.561 Call FORCE
    WHEN f$Gen_Multiway AND f$Gen_Strong AND f$Gen_PotOdds <= 0.729 AND randomround < 0.50 Call FORCE
