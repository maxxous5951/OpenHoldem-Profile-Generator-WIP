##f$Gen_EffStack##
// Stack effectif en BB (petit stack entre nous et le plus gros adversaire encore en jeu)
WHEN Others RETURN EffectiveMaxStacksizeOfActiveOpponents FORCE

##f$Gen_IP##
// Vrai si nous agirons en dernier postflop
WHEN StillToActPostflop = 0 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Facing##
// Taille totale (en BB) de la mise adverse : ce qu'il reste a payer + ce que nous avons deja mis (blinde, ouverture). BetSize (= ncallbets) ne donne que le complement, d'ou RaiseTo faux pour les blindes et apres notre relance
WHEN Others RETURN AmountToCall + ncurrentbets FORCE

##f$Gen_Multiway##
WHEN Opponents >= 2 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$preflop##
// OHPG : fonction preflop. Chaque bloc WHEN sans action est un scenario ; il se termine par un fold/check.
// === OUVERTURE (personne n'est entre dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    WHEN InMiddlePosition2 AND listOpenEP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition2 AND listOpenEPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InMiddlePosition3 AND listOpenMP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition3 AND listOpenMPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InCutOff AND listOpenCO RaiseTo 2.3 FORCE
    WHEN InCutOff AND listOpenCOEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenSB RaiseTo 3 FORCE
    WHEN InSmallBlind AND listOpenSBEdge AND randomhand < 0.50 RaiseTo 3 FORCE
    WHEN Others Fold FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND InMiddlePosition2 AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition2 AND listIso1EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition3 AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition3 AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition2 AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition2 AND listIso2EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition3 AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition3 AND listIso2MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listOpenEP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition2 AND listIso3EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition2 AND listIso3EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition3 AND listIso3MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition3 AND listIso3MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN InBigBlind Check FORCE
    WHEN Others Fold FORCE
// === FACE A UNE OUVERTURE (aucun caller) : 3bet value + bluffs, call, fold ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise = 0
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVMPEPSV RaiseMax FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPC Call FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPCp AND randomhand < 0.50 Call FORCE
