    WHEN f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.208 AND randomround < 0.50 Call FORCE
    WHEN Others Fold FORCE
// --- On fait face à une mise (c-bet adverse, donk, etc.) ---
WHEN AmountToCall > 0
    WHEN NOT f$Gen_Multiway AND HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
