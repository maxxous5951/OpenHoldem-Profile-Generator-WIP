WHEN AmountToCall = 0
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND HaveNuts RaiseBy 110% FORCE
    WHEN f$Gen_IP AND NOT f$Gen_Multiway AND f$Gen_Monster RaiseBy 70% FORCE
