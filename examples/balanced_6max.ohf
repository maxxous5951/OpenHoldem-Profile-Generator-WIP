    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND listSq1MPV RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition3 AND listSq1MPB RaiseTo (f$Gen_Facing * 3.8 + f$Gen_Facing * (CallsSinceLastRaise - 1)) FORCE
