##f$Gen_EffStack##
// Stack effectif en BB (petit stack entre nous et le plus gros adversaire encore en jeu)
WHEN Others RETURN EffectiveMaxStacksizeOfActiveOpponents FORCE

##f$Gen_IP##
// Vrai si nous agirons en dernier postflop
WHEN StillToActPostflop = 0 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_Facing##
// Taille totale (en BB) de la mise adverse : ce qu'il reste a payer + ce que nous avons deja mis (blinde, ouverture). BetSize (= ncallbets) ne donne que le complement, d'ou RaiseTo faux pour les blindes et apres notre relance
WHEN Others RETURN AmountToCall + ncurrentbets FORCE

##f$Gen_Multiway##
WHEN Opponents >= 2 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$preflop##
// OHPG : fonction preflop. Chaque bloc WHEN sans action est un scenario ; il se termine par un fold/check.
// === OUVERTURE (personne n'est entre dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    WHEN InMiddlePosition2 AND listOpenEP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition2 AND listOpenEPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InMiddlePosition3 AND listOpenMP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition3 AND listOpenMPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InCutOff AND listOpenCO RaiseTo 2.3 FORCE
    WHEN InCutOff AND listOpenCOEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenSB RaiseTo 3 FORCE
    WHEN InSmallBlind AND listOpenSBEdge AND randomhand < 0.50 RaiseTo 3 FORCE
    WHEN Others Fold FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND InMiddlePosition2 AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition2 AND listIso1EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition3 AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition3 AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1BB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1BBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition2 AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition2 AND listIso2EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition3 AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition3 AND listIso2MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso2CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso2COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso2BB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso2BBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition2 AND listIso3EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition2 AND listIso3EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition3 AND listIso3MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition3 AND listIso3MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso3CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso3BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso3BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3BB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3BBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN InBigBlind Check FORCE
    WHEN Others Fold FORCE
// === FACE A UNE OUVERTURE (aucun caller) : 3bet value + bluffs, call, fold ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise = 0
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVMPEPSV RaiseMax FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPC Call FORCE
    WHEN InMiddlePosition3 AND MiddlePosition2Raising AND listVMPEPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVCOEPSV RaiseMax FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPV RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPB RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPC Call FORCE
    WHEN InCutOff AND MiddlePosition2Raising AND listVCOEPCp AND randomhand < 0.50 Call FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVCOMPSV RaiseMax FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPV RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPB RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPC Call FORCE
    WHEN InCutOff AND MiddlePosition3Raising AND listVCOMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVBTNEPSV RaiseMax FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPV RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPB RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPC Call FORCE
    WHEN InButton AND MiddlePosition2Raising AND listVBTNEPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVBTNMPSV RaiseMax FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPV RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPB RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPC Call FORCE
    WHEN InButton AND MiddlePosition3Raising AND listVBTNMPCp AND randomhand < 0.50 Call FORCE
    WHEN InButton AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVBTNCOSV RaiseMax FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOV RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOB RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 3) FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOC Call FORCE
    WHEN InButton AND CutOffRaising AND listVBTNCOCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVSBEPSV RaiseMax FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPC Call FORCE
    WHEN InSmallBlind AND MiddlePosition2Raising AND listVSBEPCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVSBMPSV RaiseMax FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPC Call FORCE
    WHEN InSmallBlind AND MiddlePosition3Raising AND listVSBMPCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVSBCOSV RaiseMax FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOC Call FORCE
    WHEN InSmallBlind AND CutOffRaising AND listVSBCOCp AND randomhand < 0.50 Call FORCE
    WHEN InSmallBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVSBBTNSV RaiseMax FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNC Call FORCE
    WHEN InSmallBlind AND ButtonRaising AND listVSBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND f$Gen_EffStack <= 20 AND listVBBEPSV RaiseMax FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPC Call FORCE
    WHEN InBigBlind AND MiddlePosition2Raising AND listVBBEPCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND f$Gen_EffStack <= 20 AND listVBBMPSV RaiseMax FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBBMPV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBBMPB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBBMPBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBBMPC Call FORCE
    WHEN InBigBlind AND MiddlePosition3Raising AND listVBBMPCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND CutOffRaising AND f$Gen_EffStack <= 20 AND listVBBCOSV RaiseMax FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOC Call FORCE
    WHEN InBigBlind AND CutOffRaising AND listVBBCOCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND ButtonRaising AND f$Gen_EffStack <= 20 AND listVBBBTNSV RaiseMax FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNC Call FORCE
    WHEN InBigBlind AND ButtonRaising AND listVBBBTNCp AND randomhand < 0.50 Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND f$Gen_EffStack <= 20 AND listVBBSBSV RaiseMax FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBV RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBB RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBBp AND randomhand < 0.50 RaiseTo (f$Gen_Facing * 4) FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBC Call FORCE
    WHEN InBigBlind AND SmallBlindRaising AND listVBBSBCp AND randomhand < 0.50 Call FORCE
    WHEN Others Fold FORCE
// === SQUEEZE : une ouverture et un ou plusieurs callers ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise >= 1
    WHEN CallsSinceLastRaise = 1 AND InMiddlePosition2 AND f$Gen_EffStack <= 20 AND listSq1EPSV RaiseMax FORCE
