##f$Gen_EffStack##
// Stack effectif en BB (petit stack entre nous et le plus gros adversaire encore en jeu)
WHEN Others RETURN EffectiveMaxStacksizeOfActiveOpponents FORCE

##f$Gen_IP##
// Vrai si nous agirons en dernier postflop
WHEN StillToActPostflop = 0 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$Gen_PotOdds##
// Équité nécessaire pour payer : AmountToCall / (PotSize + AmountToCall)
WHEN AmountToCall <= 0 RETURN 0 FORCE
WHEN Others RETURN AmountToCall / (PotSize + AmountToCall) FORCE

##f$Gen_Multiway##
WHEN Opponents >= 2 RETURN true FORCE
WHEN Others RETURN false FORCE

##f$preflop##
// OHPG : fonction préflop. Chaque bloc WHEN sans action est un scénario ; il se termine par un fold/check.
// === OUVERTURE (personne n'est entré dans le pot) ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls = 0
    WHEN InEarlyPosition AND listOpenEP RaiseTo 2.5 FORCE
    WHEN InEarlyPosition AND listOpenEPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InMiddlePosition AND listOpenMP RaiseTo 2.5 FORCE
    WHEN InMiddlePosition AND listOpenMPEdge AND randomhand < 0.50 RaiseTo 2.5 FORCE
    WHEN InCutOff AND listOpenCO RaiseTo 2.3 FORCE
    WHEN InCutOff AND listOpenCOEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTN RaiseTo 2.3 FORCE
    WHEN InButton AND listOpenBTNEdge AND randomhand < 0.50 RaiseTo 2.3 FORCE
    WHEN InSmallBlind AND listOpenSB RaiseTo 3 FORCE
    WHEN InSmallBlind AND listOpenSBEdge AND randomhand < 0.50 RaiseTo 3 FORCE
    WHEN Others Fold FORCE
// === LIMPERS DEVANT : isolation / overlimp ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 0 AND Calls >= 1
    WHEN Calls = 1 AND InEarlyPosition AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InEarlyPosition AND listIso1EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InMiddlePosition AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InCutOff AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTN RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InButton AND listIso1BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SB RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InSmallBlind AND listIso1SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1CO RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 1 AND InBigBlind AND listIso1COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InEarlyPosition AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InEarlyPosition AND listIso2EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InMiddlePosition AND listIso2MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InCutOff AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listOpenEP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InButton AND listIso2BTNEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso1EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InSmallBlind AND listIso2SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls = 2 AND InBigBlind AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InEarlyPosition AND listIso3EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InEarlyPosition AND listIso3EPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition AND listIso3MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InMiddlePosition AND listIso3MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InCutOff AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso1MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InButton AND listIso1MPEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso2EP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InSmallBlind AND listIso3SBEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso2MP RaiseTo (3.5 + Calls) FORCE
    WHEN Calls >= 3 AND InBigBlind AND listIso3COEdge AND randomhand < 0.50 RaiseTo (3.5 + Calls) FORCE
    WHEN InBigBlind Check FORCE
    WHEN Others Fold FORCE
// === FACE À UNE OUVERTURE (aucun caller) : 3bet value + bluffs, call, fold ===
WHEN BotsActionsOnThisRoundIncludingChecks = 0 AND Raises = 1 AND CallsSinceLastRaise = 0
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVEPEPSV RaiseMax FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPV RaiseTo (BetSize * 4) FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPB RaiseTo (BetSize * 4) FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPC Call FORCE
    WHEN InEarlyPosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPCp AND randomhand < 0.50 Call FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND f$Gen_EffStack <= 20 AND listVMPEPSV RaiseMax FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPV RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPEPB RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVMPEPBp AND randomhand < 0.50 RaiseTo (BetSize * 4) FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPC Call FORCE
    WHEN InMiddlePosition AND (EarlyPosition1Raising OR EarlyPosition2Raising OR EarlyPosition3Raising) AND listVEPEPCp AND randomhand < 0.50 Call FORCE
