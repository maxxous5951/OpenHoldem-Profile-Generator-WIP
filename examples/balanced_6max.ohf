    WHEN f$Gen_Multiway AND f$Gen_WeakDraw AND f$Gen_PotOdds <= 0.221 AND randomround < 0.50 Call FORCE
    WHEN f$Gen_Multiway Fold FORCE
// --- On nous relance apres notre mise ---
WHEN AmountToCall > 0 AND RaisesSinceLastPlay >= 1 AND BotsActionsOnThisRoundIncludingChecks >= 1
    WHEN HaveNuts AND f$Gen_PotOdds < 2 RaiseBy 100% FORCE
    WHEN f$Gen_Monster AND randomround < 0.55 RaiseBy 100% FORCE
    WHEN f$Gen_Monster Call FORCE
    WHEN f$Gen_Strong AND randomround < 0.19 RaiseBy 100% FORCE
    WHEN f$Gen_Strong AND f$Gen_PotOdds <= 0.528 Call FORCE
